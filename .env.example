# --- Claude API ---------------------------------------------------------
# Leave unset if you have already run `ant auth login`; the SDK picks up the
# stored profile automatically.
ANTHROPIC_API_KEY=

# Model + effort. See README for the cost/quality tradeoff.
CLAUDE_MODEL=claude-opus-5
CLAUDE_CLASSIFY_EFFORT=low
CLAUDE_DIGEST_EFFORT=high

# --- Collector ----------------------------------------------------------
# Where Playwright persists your logged-in session (written by `npm run login`).
FB_STORAGE_STATE=./storage-state.json

# Run with a visible browser so you can clear a checkpoint yourself.
# Headless is intentionally NOT the default — see README.
HEADLESS=false

# Politeness limits. These keep load low; they are not evasion settings.
SCROLLS_PER_GROUP=8
DELAY_BETWEEN_GROUPS_MS=5000
MAX_POSTS_PER_GROUP=60

# --- Email --------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="FB Digest <you@example.com>"
MAIL_TO=you@example.com
