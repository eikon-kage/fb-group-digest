# --- Claude API ---------------------------------------------------------
# Leave unset if you have already run `ant auth login`; the SDK picks up the
# stored profile automatically.
ANTHROPIC_API_KEY=

# Model + effort. See README for the cost/quality tradeoff.
CLAUDE_MODEL=claude-opus-5
CLAUDE_CLASSIFY_EFFORT=low
CLAUDE_DIGEST_EFFORT=high

# --- Collector ----------------------------------------------------------
# Chromium profile directory holding your logged-in session (written by
# `npm run login`). Treat it like a password file — it holds your cookies.
FB_USER_DATA_DIR=./.fb-profile

# Run with a visible browser so you can clear a checkpoint yourself.
# Headless is intentionally NOT the default — see README.
HEADLESS=false

# Politeness limits. These keep load low; they are not evasion settings.
SCROLLS_PER_GROUP=8
DELAY_BETWEEN_GROUPS_MS=5000
MAX_POSTS_PER_GROUP=60

# Dừng cuộn khi đáy cửa sổ feed gặp ngần này bài đã lấy lần trước liên tiếp —
# tức là đã đi hết phần bài mới. Đặt 0 để tắt (mỗi lần chạy cuộn lại từ đầu).
STOP_AFTER_SEEN=5

# Collect the poster's name, avatar, profile link and user id. This is personal
# data — see the README before leaving it on.
COLLECT_AUTHORS=true

# Download avatars as base64 data URIs. Costs disk and makes data/posts.json
# many times larger, but the HTML report then shows avatars offline and inside
# an email client, which blocks remote images by default.
INLINE_AVATARS=true

# --- Email --------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="FB Digest <you@example.com>"
MAIL_TO=nguyenquangvinhjit@gmail.com
